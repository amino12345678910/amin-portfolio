# Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# N8N Webhook Configuration (Server-side only)
N8N_WEBHOOK_PRIMARY=https://n8n.safonas.com/webhook/your-actual-webhook-id
N8N_WEBHOOK_FALLBACK=https://backup.n8n.safonas.com/webhook/your-fallback-webhook-id

# Webhook Settings
WEBHOOK_TIMEOUT=30
WEBHOOK_MAX_RETRIES=3

# Security Configuration
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=3600
ENCRYPTION_KEY=your_random_32_character_encryption_key
JWT_SECRET=your_jwt_secret_key_here

# CORS Configuration
ALLOWED_ORIGINS=https://safonas.com,https://www.safonas.com,http://localhost:3000

# Development Settings
DEBUG_MODE=false
LOG_LEVEL=error

# Session Configuration
SESSION_LIFETIME=3600
CSRF_TOKEN_LIFETIME=3600