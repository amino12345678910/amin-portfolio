# =============================================================================
# Deployment Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment
# =============================================================================

# Environment
ENVIRONMENT=production
DEBUG=false

# GitHub Repository Configuration
GITHUB_REPO_URL=https://github.com/your-username/your-repo.git
DEPLOYMENT_BRANCH=main

# GitHub Webhook Configuration
GITHUB_WEBHOOK_SECRET=generate_a_secure_32_character_secret_here

# Git Configuration
GIT_AUTHOR_NAME=Deployment Bot
GIT_AUTHOR_EMAIL=deploy@safonas.tn

# Deployment Paths
DEPLOYMENT_ROOT=/path/to/your/public_html
GIT_REPO_PATH=/path/to/your/public_html/.git

# Security Configuration
DEPLOY_PASSWORD=your_secure_deployment_password_here

# Health Check Configuration
HEALTH_CHECK_URL=https://yourdomain.com/health-check.php

# Notification Configuration
NOTIFICATION_EMAIL=admin@safonas.tn
FROM_EMAIL=noreply@safonas.tn

# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Slack Configuration (for Slack notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#deployments

# Logging Configuration
LOG_LEVEL=INFO

# Database Configuration (if applicable)
# DB_HOST=localhost
# DB_NAME=your_database
# DB_USER=your_username
# DB_PASS=your_password

# Additional Security Headers
# CSP_HEADER=default-src 'self' https:; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net

# Performance Configuration
# MAX_EXECUTION_TIME=300
# MEMORY_LIMIT=512M